# Set false only for local HTTP; use true when deployed with HTTPS.
SESSION_COOKIE_SECURE=true
# Generate a long random secret before connecting Bolna.
HAQRECORD_SERVICE_API_KEY=

BOLNA_API_KEY=

BOLNA_AGENT_ID=

HAQRECORD_VOICE_TOOL_SECRET=

HAQRECORD_VOICE_PUBLIC_URL=

# Optional official-resource research; do not put keys in frontend files.
EXA_API_KEY=

# Optional private image extraction and uploaded PCM WAV transcription.
# Bolna's provider credentials do not grant direct access to these APIs.
SARVAM_API_KEY=
HAQRECORD_REPLY_MODEL=gemma4
# Separate full application deployment; never use the callback-only bridge URL.
HAQRECORD_PUBLIC_APP_URL=
# Optional isolated demo database paths; keep outside source control.
HAQRECORD_DB_PATH=
HAQRECORD_AUTH_DB_PATH=
HAQRECORD_DEMO=false
